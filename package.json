{
  "name": "@horpynka/api-sdk",
  "version": "1.0.0",
  "description": "Shared API client and TanStack Query hooks for Horpynka admin panel and cashier app",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./hooks": {
      "import": {
        "types": "./dist/hooks/index.d.ts",
        "default": "./dist/hooks/index.js"
      },
      "require": {
        "types": "./dist/hooks/index.d.cts",
        "default": "./dist/hooks/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "generate-api-client": "npx openapi-generator-cli generate -i https://horpynka.com/api/docs-json -g typescript-axios -o src/api/generated --skip-validate-spec && node scripts/patch-generated-api-client.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.7.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.17.0",
    "@tanstack/react-query": "^5.85.5",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "axios": "^1.11.0",
    "react": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  }
}
